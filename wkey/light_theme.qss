/* === Combined Light Theme with Simulated Shadow Effects (QSS only) — Cleaned === */

QMainWindow, QWidget, QFrame, QLabel, QPushButton, QCheckBox {
    background-color: #FAFAFA;
    color: #1E1E1E;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 10.5pt;
}

QFrame#statusPanel, QFrame#controlsPanel {
    background-color: #FFFFFF;
    border: 1px solid #CCCCCC;
    border-radius: 12px;
    padding: 20px;
    outline: 2px solid rgba(100,100,100,0.12);
    outline-offset: 2px;
    margin: 6px;
}

QLabel#titleLabel {
    font-size: 22pt;
    font-weight: bold;
    color: #212121;
    padding: 12px 0;
    min-height: 36px;
    qproperty-alignment: AlignCenter;
}

QLabel#subtitleLabel {
    color: #666;
    font-size: 11pt;
    margin-bottom: 12px;
    qproperty-alignment: AlignCenter;
}

QLabel#statusIndicator {
    font-weight: bold;
    font-size: 11.5pt;
    padding: 10px;
    min-height: 34px;
    border: 1px solid #BBBBBB;
    border-radius: 6px;
    background-color: #F0F0F0;
    outline: 1px solid rgba(150,150,150,0.2);
    outline-offset: 2px;
    qproperty-alignment: AlignCenter;
}

QLabel#timerIcon {
    min-width: 22px;
    font-size: 13pt;
    color: #1565C0;
}

QLabel#timerTitle {
    font-size: 10pt;
    font-weight: 500;
    color: #444;
    padding: 4px 0;
}

QLabel#timerValue {
    font-family: "Courier New", monospace;
    color: #212121;
    padding: 4px 0;
    qproperty-alignment: AlignRight;
}

QPushButton {
    padding: 12px 16px;
    font-size: 10.5pt;
    border-radius: 6px;
    border-width: 2px;
    border-style: solid;
    font-weight: 600;
    outline: 1px solid rgba(180,180,180,0.2);
    outline-offset: 1px;
}

QPushButton#mainButton {
    background-color: #42A5F5;
    color: #FFFFFF;
    border-color: #2196F3;
}
QPushButton#mainButton:hover {
    background-color: #2196F3;
    border-color: #1976D2;
}
QPushButton#mainButton:pressed {
    background-color: #1565C0;
    border-color: #0D47A1;
}

QPushButton#pause15MinButton {
    background-color: #FFF59D;
    color: #1E1E1E;
    border-color: #FDD835;
}
QPushButton#pause15MinButton:hover {
    background-color: #FDD835;
    border-color: #FBC02D;
}
QPushButton#pause15MinButton:pressed {
    background-color: #FBC02D;
    border-color: #F9A825;
    color: #FFFFFF;
}

QPushButton#pause1HrButton {
    background-color: #C8E6C9;
    color: #2E7D32;
    border-color: #81C784;
}
QPushButton#pause1HrButton:hover {
    background-color: #81C784;
    border-color: #4CAF50;
}
QPushButton#pause1HrButton:pressed {
    background-color: #4CAF50;
    border-color: #388E3C;
    color: #FFFFFF;
}

QPushButton#fasterWhisperButton {
    background-color: #FFCC80;
    color: #4E342E;
    border-color: #FFA726;
}
QPushButton#fasterWhisperButton:hover {
    background-color: #FFA726;
    border-color: #FB8C00;
    color: #000000;
}
QPushButton#fasterWhisperButton:pressed {
    background-color: #FB8C00;
    border-color: #EF6C00;
    color: #FFFFFF;
}

QPushButton#themeButton {
    background-color: #BA68C8;
    color: #FFFFFF;
    border-color: #AB47BC;
}
QPushButton#themeButton:hover {
    background-color: #AB47BC;
    border-color: #9C27B0;
}
QPushButton#themeButton:pressed {
    background-color: #8E24AA;
    border-color: #6A1B9A;
    color: #FFFFFF;
}

QCheckBox#settingsCheckbox {
    color: #1E1E1E;
    font-size: 10pt;
    spacing: 6px;
    padding: 4px;
}

QCheckBox#settingsCheckbox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    background-color: #EEEEEE;
    border: 1px solid #B0BEC5;
}

QCheckBox#settingsCheckbox::indicator:checked {
    background-color: #42A5F5;
    border: 1px solid #2196F3;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: #F0F0F0;
    border: none;
    width: 6px;
    height: 6px;
}

QScrollBar::handle {
    background: #BDBDBD;
    border-radius: 3px;
}

QScrollBar::handle:hover {
    background: #9E9E9E;
}

QToolTip {
    background-color: #FFFFFF;
    color: #1E1E1E;
    border: 1px solid #CCCCCC;
    padding: 8px;
    border-radius: 4px;
    font-size: 10pt;
}

QLabel#hotkeyLabel {
    color: #666666;
    font-size: 9pt;
    padding-top: 6px;
    qproperty-alignment: AlignCenter;
}

QLabel#errorLabel {
    color: #D32F2F;
    background-color: rgba(211, 47, 47, 0.08);
    border-radius: 4px;
    padding: 6px;
    margin-top: 10px;
    qproperty-alignment: AlignCenter;
}