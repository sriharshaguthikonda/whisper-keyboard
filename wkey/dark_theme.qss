/* === Combined Dark Theme with Simulated Shadow Effects (QSS only) — Enhanced UI Polish === */

QMainWindow, QWidget, QFrame, QLabel, QPushButton, QCheckBox {
    background-color:rgb(71, 71, 71);
    color: #CDD6F4;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 10.5pt;
    }

QFrame#statusPanel, QFrame#controlsPanel {
    background-color:rgb(59, 59, 63);
    border: 1px solid #44475A;
    border-radius: 12px;
    padding: 20px;
    outline: 2px solid rgba(0,0,0,0.3);
    outline-offset: 2px;
    margin: 6px;
    }

QLabel#titleLabel {
    font-size: 22pt;
    font-weight: bold;
    color: #F5E0DC;
    padding: 12px 0;
    min-height: 36px;
    qproperty-alignment: AlignCenter;
}

QLabel#subtitleLabel {
    color: #A6ADC8;
    font-size: 11pt;
    margin-bottom: 12px;
    qproperty-alignment: AlignCenter;
}

QLabel#statusIndicator {
    font-weight: bold;
    font-size: 11.5pt;
    padding: 10px;
    min-height: 34px;
    border: 1px solid #6C7086;
    border-radius: 6px;
    background-color: #313244;
    outline: 1px solid rgba(0,0,0,0.5);
    outline-offset: 2px;
    qproperty-alignment: AlignCenter;
    }

QLabel#timerIcon {
    min-width: 22px;
    font-size: 13pt;
    color: #89B4FA;
}

QLabel#timerTitle {
    font-size: 10pt;
    font-weight: 500;
    color: #BAC2DE;
    padding: 4px 0;
}

QLabel#timerValue {
    font-family: "Courier New", monospace;
    color: #CDD6F4;
    padding: 4px 0;
    qproperty-alignment: AlignRight;
}

QPushButton {
    padding: 12px 16px;
    font-size: 10.5pt;
    border-radius: 6px;
    border-width: 2px;
    border-style: solid;
    font-weight: 600;
    outline: 1px solid rgba(0,0,0,0.3);
    outline-offset: 1px;
    }

QPushButton#mainButton {
    background-color: #89B4FA;
    color: #1E1E2E;
    border-color: #4C9ED9;
}
QPushButton#mainButton:hover {
    background-color: #74C7EC;
    border-color: #A6E3FA;
}
QPushButton#mainButton:pressed {
    background-color: #5E81AC;
    border-color: #4C669F;
    color: #FFFFFF;
}

QPushButton#pause15MinButton {
    background-color: #F9E2AF;
    color: #1E1E2E;
    border-color: #E6C68A;
}
QPushButton#pause15MinButton:hover {
    background-color: #E8C68A;
    border-color: #FFD180;
}
QPushButton#pause15MinButton:pressed {
    background-color: #D4A568;
    border-color: #C0925B;
    color: #FFFFFF;
}

QPushButton#pause1HrButton {
    background-color: #A6DA95;
    color: #1E1E2E;
    border-color: #8BBA7F;
}
QPushButton#pause1HrButton:hover {
    background-color: #8BBA7F;
    border-color: #A6DA95;
}
QPushButton#pause1HrButton:pressed {
    background-color: #6DA162;
    border-color: #5A8A50;
    color: #FFFFFF;
}

QPushButton#fasterWhisperButton {
    background-color: #FAB387;
    color: #1E1E2E;
    border-color: #E6A56E;
}
QPushButton#fasterWhisperButton:hover {
    background-color: #E6A56E;
    border-color: #FFC08A;
    color: #000000;
}
QPushButton#fasterWhisperButton:pressed {
    background-color: #D18753;
    border-color: #B06C3F;
    color: #FFFFFF;
}

QPushButton#themeButton {
    background-color: #CBA6F7;
    color: #1E1E2E;
    border-color: #B48EAD;
}
QPushButton#themeButton:hover {
    background-color: #B48EAD;
    border-color: #D6A9EF;
    color: #000000;
}
QPushButton#themeButton:pressed {
    background-color: #9A6797;
    border-color: #88578A;
    color: #FFFFFF;
}

QCheckBox#settingsCheckbox {
    color: #CDD6F4;
    font-size: 10pt;
    spacing: 6px;
    padding: 4px;
}

QCheckBox#settingsCheckbox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    background-color: #45475A;
    border: 1px solid #585B70;
}

QCheckBox#settingsCheckbox::indicator:checked {
    background-color: #89B4FA;
    border: 1px solid #74C7EC;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: #2A2A40;
    border: none;
    width: 6px;
    height: 6px;
}

QScrollBar::handle {
    background: #585B70;
    border-radius: 3px;
}

QScrollBar::handle:hover {
    background: #6C7086;
}

QToolTip {
    background-color: #27273A;
    color: #CDD6F4;
    border: 1px solid #45475A;
    padding: 8px;
    border-radius: 4px;
    font-size: 10pt;
}

QLabel#hotkeyLabel {
    color: #A6ADC8;
    font-size: 9pt;
    padding-top: 6px;
    qproperty-alignment: AlignCenter;
}

QLabel#errorLabel {
    color: #F38BA8;
    background-color: rgba(243, 139, 168, 0.08);
    border-radius: 4px;
    padding: 6px;
    margin-top: 10px;
    qproperty-alignment: AlignCenter;
}